# Matplotlib style used for the figures in the 2026 High-Redshift-Black-Hole-Growth
# paper. Copied verbatim from SciencePlots' base "science" style
# (https://github.com/garrettj403/SciencePlots) -- kept as a local copy rather
# than a package import/external path so the paper-figure scripts in this
# directory don't depend on scienceplots being installed, or on the specific
# venv path it happened to be installed in when this was written. This
# scienceplots release does not ship a dedicated "mnras" journal style; this
# is its closest general-purpose style (serif + LaTeX text, inward ticks on
# all four sides, no background grid), used here as the MNRAS-style stand-in.

axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])

figure.figsize : 3.5, 2.625

xtick.direction : in
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.size : 1.5
xtick.minor.width : 0.5
xtick.minor.visible : True
xtick.top : True

ytick.direction : in
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.size : 1.5
ytick.minor.width : 0.5
ytick.minor.visible : True
ytick.right : True

axes.linewidth : 0.5
axes.grid : False
grid.linewidth : 0.5
lines.linewidth : 1.

legend.frameon : False

savefig.bbox : tight
savefig.pad_inches : 0.05

font.family : serif
mathtext.fontset : dejavuserif

text.usetex : True
text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb}
